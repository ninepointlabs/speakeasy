#!/usr/bin/env python3
"""Speakeasy: run AI coding agents in hidden terminals, one named tab per task.

Every task is a tmux session on a private socket (`tmux -L speakeasy`), so the
agent keeps working with no window on screen. Claude Code reports its state
through hooks and Codex through its `notify` program; other agents are
watched for output going quiet. When a task needs you, or finishes a turn, a
desktop notification appears, and clicking it opens that task's terminal.
Closing the terminal only detaches: the task carries on out of sight.

Only the Python standard library and tmux are required. notify-send enables
notifications; hyprctl (Hyprland) lets `open` focus a window that is already
showing the task instead of opening a second one.
"""

import argparse
import glob
import re
import datetime as dt
import fcntl
import json
import os
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time

VERSION = "0.2.0"
SOCKET = "speakeasy"
HOME = os.path.expanduser("~")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"), "speakeasy")
TASKS_DIR = os.path.join(STATE_DIR, "tasks")
REV_PATH = os.path.join(STATE_DIR, "rev")
PREFS_PATH = os.path.join(STATE_DIR, "prefs.json")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "speakeasy")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
TMUX_CONF = os.path.join(STATE_DIR, "tmux.conf")
SELF = os.path.realpath(__file__)

# Status values, in the order the panel sorts them.
#   needs-you  the agent is blocked on you: an approval or a question
#   ready      the agent finished a turn; results are waiting to be read
#   running    working
#   starting   tmux session created, agent not reporting yet
#   exited     the agent process ended on its own
#   stopped    you stopped it
LIVE = ("starting", "running", "needs-you", "ready")
FINISHED = ("exited", "stopped")

# Known agents. `models` are offered in the picker; "" means "the agent's own
# default". `prompt` says how the first prompt is delivered: as an argument
# (`arg`), behind a flag (`flag:<name>`), or typed into the TUI (`keys`).
# `report` is how Speakeasy learns the agent's state: `claude` hooks, the
# `codex` notify program, or `watch` (output going quiet). `modelsCommand`
# asks the agent for its live model list (tab-separated "id<TAB>label" lines);
# the answer is cached and refreshed in the background.
# Claude Code has no command that lists models. The aliases track the newest
# release; the full names pin a version. All of them appear in Claude Code
# itself (checked against v2.1.284).
CLAUDE_MODELS = [
    ("", "Default (your Claude Code setting)"),
    ("fable", "Fable · latest"),
    ("opus", "Opus · latest"),
    ("sonnet", "Sonnet · latest"),
    ("haiku", "Haiku · latest"),
    ("opusplan", "Opus plans, Sonnet builds"),
    ("fable[1m]", "Fable · latest · 1M context"),
    ("opus[1m]", "Opus · latest · 1M context"),
    ("sonnet[1m]", "Sonnet · latest · 1M context"),
    ("claude-fable-5-1", "Fable 5.1"),
    ("claude-opus-5-5", "Opus 5.5"),
    ("claude-sonnet-5-5", "Sonnet 5.5"),
    ("claude-haiku-4-5", "Haiku 4.5"),
    ("claude-opus-5", "Opus 5"),
    ("claude-sonnet-5", "Sonnet 5"),
    ("claude-opus-4-8", "Opus 4.8"),
    ("claude-opus-4-7", "Opus 4.7"),
    ("claude-opus-4-6", "Opus 4.6"),
    ("claude-sonnet-4-6", "Sonnet 4.6"),
    ("claude-opus-4-5", "Opus 4.5"),
    ("claude-sonnet-4-5", "Sonnet 4.5"),
    ("claude-opus-4-1", "Opus 4.1"),
]

AGENTS = [
    {"id": "claude", "name": "Claude Code", "bin": "claude", "models": [m for m, _ in CLAUDE_MODELS],
     "modelLabels": dict(CLAUDE_MODELS), "modelFlag": "--model", "prompt": "keys", "report": "claude",
     "efforts": ["low", "medium", "high", "xhigh", "max"], "effortArgs": ["--effort={}"]},
    {"id": "codex", "name": "Codex", "bin": "codex", "models": [""], "modelsFile": "~/.codex/models_cache.json",
     "modelFlag": "--model", "prompt": "keys", "report": "codex",
     "effortArgs": ["-c", 'model_reasoning_effort="{}"']},
    {"id": "antigravity", "name": "Gemini", "bin": "agy", "models": [""], "modelsCommand": ["models"],
     "modelFlag": "--model", "prompt": "keys", "report": "watch"},
    {"id": "opencode", "name": "opencode", "bin": "opencode", "models": [""],
     "modelFlag": "--model", "prompt": "keys", "report": "watch"},
    {"id": "cursor-agent", "name": "Cursor Agent", "bin": "cursor-agent",
     "models": ["", "composer-2.5", "composer-2.5-fast", "gpt-5.5", "sonnet-4", "opus"],
     "modelFlag": "--model", "prompt": "keys", "report": "watch"},
    {"id": "crush", "name": "Crush", "bin": "crush", "models": [""],
     "modelFlag": None, "prompt": "keys", "report": "watch"},
    {"id": "muse", "name": "Muse", "bin": "muse", "models": [""],
     "modelsFile": "~/.local/share/muse/model-catalog/*.json", "modelsFormat": "muse",
     "modelFlag": "--model", "prompt": "keys", "report": "watch", "effortArgs": ["--reasoning-effort={}"]},
    {"id": "copilot", "name": "GitHub Copilot", "bin": "copilot", "models": [""],
     "modelFlag": "--model", "prompt": "keys", "report": "watch",
     "efforts": ["none", "minimal", "low", "medium", "high", "xhigh", "max"], "effortArgs": ["--reasoning-effort={}"]},
    {"id": "grok", "name": "Grok", "bin": "grok", "models": [""], "modelsCommand": ["models"], "modelsParse": "bullets",
     "modelFlag": "--model", "prompt": "keys", "report": "watch"},
    {"id": "hermes", "name": "Hermes", "bin": "hermes", "baseArgs": ["chat"], "models": [""],
     "modelFlag": "--model", "prompt": "keys", "report": "watch"},
]

DEFAULT_CONFIG = {
    # Command prefix used to open a task's terminal; the attach command is
    # appended. Empty = xdg-terminal-exec, then common terminals.
    "terminal": "",
    # Folder new tasks start in when none is given.
    "defaultCwd": "~",
    # Seconds of unchanged output before a watched agent counts as waiting.
    "quietSeconds": 20,
    "notify": True,
    # Per-agent overrides and additions, e.g.
    # {"codex": {"models": ["", "gpt-5.5"]}, "mine": {"name": "Mine", "bin": "mine", ...}}
    "agents": {},
    # Agent ids left out of the new-task picker (Settings, or `speakeasy agents --hide`).
    "hiddenAgents": [],
}


# ---------------------------------------------------------------- helpers --

def now():
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def load_json(path, fallback):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return fallback


# Task records hold prompts, so everything Speakeasy writes is private to the
# user: folders 0700, files 0600. This is done per file rather than with a
# umask, which would leak into the agents and make their project files private.

def private_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    if os.stat(path).st_mode & 0o077:
        os.chmod(path, 0o700)


def private_open(path, mode="w"):
    """Open for writing, creating the file 0600 (and fixing an older one)."""
    flags = os.O_WRONLY | os.O_CREAT | (os.O_APPEND if mode == "a" else os.O_TRUNC)
    fd = os.open(path, flags, 0o600)
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, mode)


def write_json(path, data):
    private_dir(os.path.dirname(path))
    tmp = f"{path}.{os.getpid()}.tmp"
    with private_open(tmp) as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def secure_existing_state():
    """Tighten folders and files left by versions before 0.2 (they were 0755/0644)."""
    for root_dir in (STATE_DIR, CONFIG_DIR):
        if not os.path.isdir(root_dir) or os.path.islink(root_dir):
            continue
        for dirpath, dirnames, filenames in os.walk(root_dir):
            if os.stat(dirpath).st_mode & 0o077:
                os.chmod(dirpath, 0o700)
            for name in filenames:
                fp = os.path.join(dirpath, name)
                if not os.path.islink(fp) and os.stat(fp).st_mode & 0o077:
                    os.chmod(fp, 0o600)


def config():
    cfg = dict(DEFAULT_CONFIG)
    user = load_json(CONFIG_PATH, {})
    if isinstance(user, dict):
        cfg.update(user)
    return cfg


def agents(cfg=None):
    """Known agents merged with config overrides, each marked installed or not."""
    cfg = cfg or config()
    extra = cfg.get("agents") or {}
    out = []
    seen = set()
    for base in AGENTS:
        a = dict(base)
        a.update(extra.get(a["id"]) or {})
        out.append(a)
        seen.add(a["id"])
    for aid, a in extra.items():
        if aid not in seen and isinstance(a, dict) and a.get("bin"):
            a = {"id": aid, "name": aid, "models": [""], "modelFlag": None, "prompt": "keys", "report": "watch", **a}
            out.append(a)
    hidden = set(cfg.get("hiddenAgents") or [])
    for a in out:
        a["hidden"] = a["id"] in hidden
        a["path"] = shutil.which(a["bin"]) or ""
        a["installed"] = a["path"] != ""
        a["modelLabels"] = dict(a.get("modelLabels") or {})
        a.setdefault("efforts", [])
        a.setdefault("modelEfforts", {})
        if a.get("modelsFile") and a["installed"]:
            read_models_file(a)
        if a.get("modelsCommand") and a["installed"]:
            cached = load_json(models_cache_path(a["id"]), {})
            live = [m for m in cached.get("models") or [] if isinstance(m, dict) and m.get("id")]
            if live:
                a["models"] = [""] + [m["id"] for m in live]
                a["modelLabels"] = {m["id"]: m.get("label") or m["id"] for m in live}
            a["modelsFetchedAt"] = cached.get("fetchedAt", 0)
    return out


def models_from_file(a):
    """[(id, label, efforts)] from an agent's own model list on disk."""
    out = []
    for path in sorted(glob.glob(os.path.expanduser(a["modelsFile"]))):
        data = load_json(path, {})
        if a.get("modelsFormat") == "muse":
            # Muse: rows with model_id, display_label and reasoning tiers.
            for m in data.get("rows") or []:
                if isinstance(m, dict) and m.get("visibility", "visible") == "visible":
                    tiers = [x.get("tier") for x in m.get("reasoning_effort_variants") or [] if isinstance(x, dict)]
                    out.append((str(m.get("model_id", "")), m.get("display_label"), tiers))
        else:
            # Codex: models with slug, display_name and supported reasoning levels.
            for m in data.get("models") or []:
                if isinstance(m, dict) and m.get("visibility", "list") == "list":
                    levels = [x.get("effort") for x in m.get("supported_reasoning_levels") or [] if isinstance(x, dict)]
                    out.append((str(m.get("slug", "")), m.get("display_name"), levels))
    return [(mid, str(label or mid), [e for e in efforts if EFFORT.match(str(e or ""))])
            for mid, label, efforts in out if MODEL_ID.match(mid)]


# Order effort levels from least to most, whatever order a catalog uses.
EFFORT_ORDER = ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]


def read_models_file(a):
    listed = models_from_file(a)
    if not listed:
        return
    a["models"] = [""] + [mid for mid, _, _ in listed]
    for mid, label, efforts in listed:
        a["modelLabels"][mid] = label
        if efforts:
            a["modelEfforts"][mid] = sorted(efforts, key=lambda e: EFFORT_ORDER.index(e) if e in EFFORT_ORDER else 99)
    # With the model left to Codex, offer only levels every model accepts.
    sets = [a["modelEfforts"][k] for k in a["modelEfforts"]]
    if sets:
        a["efforts"] = [e for e in sets[0] if all(e in x for x in sets[1:])]


MODEL_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/\[\]-]{0,99}$")
EFFORT = re.compile(r"^[a-z]{1,20}$")


def efforts_for(agent, model):
    return agent["modelEfforts"].get(model) or agent["efforts"] if agent.get("effortArgs") else []


MODELS_MAX_AGE = 6 * 3600


def models_cache_path(aid):
    return os.path.join(STATE_DIR, "models", f"{aid}.json")


def fetch_models(agent):
    """Ask the agent for its models and cache them; returns the list or None."""
    try:
        r = subprocess.run([agent["path"]] + agent["modelsCommand"], text=True, capture_output=True,
                           timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    models = []
    for line in r.stdout.splitlines():
        if agent.get("modelsParse") == "bullets":
            # "  - grok-4.7" / "  * grok-4.6 (default)"
            line = line.strip()
            if line[:2] in ("- ", "* "):
                mid = line[2:].split()[0] if line[2:].split() else ""
                if MODEL_ID.match(mid):
                    models.append({"id": mid, "label": mid + (" (default)" if line.startswith("*") else "")})
            continue
        mid, sep, label = line.partition("\t")
        mid = mid.strip()
        # Status chatter ("Fetching available models...") has no tab.
        if sep and MODEL_ID.match(mid):
            models.append({"id": mid, "label": label.strip() or mid})
    if r.returncode != 0 or not models:
        return None
    write_json(models_cache_path(agent["id"]), {"fetchedAt": time.time(), "models": models})
    bump_rev()
    return models


def refresh_stale_models(items):
    """Kick off a background refresh for agents whose model cache is old."""
    for a in items:
        if not (a.get("modelsCommand") and a["installed"]):
            continue
        if time.time() - (a.get("modelsFetchedAt") or 0) < MODELS_MAX_AGE:
            continue
        marker = models_cache_path(a["id"]) + ".refreshing"
        try:
            if time.time() - os.path.getmtime(marker) < 120:
                continue  # one already running (or failed moments ago)
        except OSError:
            pass
        os.makedirs(os.path.dirname(marker), exist_ok=True)
        open(marker, "w").close()
        subprocess.Popen([sys.executable, SELF, "models", a["id"], "--refresh", "--quiet"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)


def cmd_models(a):
    items = [x for x in agents() if not a.agent or x["id"] == a.agent]
    if a.agent and not items:
        die(f"unknown agent {a.agent!r}")
    for x in items:
        if a.refresh and x.get("modelsCommand") and x["installed"]:
            if fetch_models(x) is None and not a.quiet:
                print(f"speakeasy: could not list {x['name']} models", file=sys.stderr)
            x = next(y for y in agents() if y["id"] == x["id"])
        if a.quiet:
            continue
        print(f"{x['name']} ({x['id']})")
        for m in x["models"]:
            label = x["modelLabels"].get(m, "")
            print(f"  {m or 'default':<28} {label}")


def agent_by_id(aid):
    for a in agents():
        if a["id"] == aid:
            return a
    return None


def bump_rev():
    """Touch the revision file the Omarchy panel watches for changes."""
    private_dir(STATE_DIR)
    with private_open(REV_PATH) as f:
        f.write(f"{time.time():.3f}\n")


TASK_ID = re.compile(r"^[0-9a-f]{6}$")


def task_path(tid):
    if not TASK_ID.match(str(tid)):
        die(f"bad task id {tid!r}")
    return os.path.join(TASKS_DIR, f"{tid}.json")


def load_task(tid):
    return load_json(task_path(tid), None)


def update_task(tid, **fields):
    """Read-modify-write a task under an exclusive lock; returns the new task."""
    private_dir(TASKS_DIR)
    with private_open(task_path(tid) + ".lock") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        task = load_task(tid)
        if task is None:
            return None
        task.update(fields)
        task["updatedAt"] = now()
        write_json(task_path(tid), task)
    bump_rev()
    return task


def all_tasks():
    try:
        names = os.listdir(TASKS_DIR)
    except OSError:
        return []
    tasks = [load_json(os.path.join(TASKS_DIR, n), None) for n in names if n.endswith(".json")]
    return [t for t in tasks if isinstance(t, dict)]


def resolve(ref):
    """Find a task by id, id prefix, or (case-insensitive) title."""
    tasks = all_tasks()
    for t in tasks:
        if t["id"] == ref:
            return t
    hits = [t for t in tasks if t["id"].startswith(ref)] or \
           [t for t in tasks if t["title"].lower() == ref.lower()] or \
           [t for t in tasks if ref.lower() in t["title"].lower()]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        die(f"no task matches {ref!r}")
    die(f"{ref!r} matches several tasks: " + ", ".join(f"{t['id']} ({t['title']})" for t in hits))


def die(msg, code=1):
    print(f"speakeasy: {msg}", file=sys.stderr)
    sys.exit(code)


def session(tid):
    return f"se-{tid}"


# ------------------------------------------------------------------- tmux --

def tmux(*args, check=False, capture=True, stdin=None):
    cmd = ["tmux", "-L", SOCKET, "-f", TMUX_CONF, *args]
    return subprocess.run(cmd, check=check, text=True, input=stdin,
                          stdout=subprocess.PIPE if capture else None,
                          stderr=subprocess.PIPE if capture else None)


def paste(tid, text, enter=True):
    """Type text into a task through a tmux paste buffer fed on stdin, so it
    never appears in any process's arguments. Bracketed paste keeps a
    multi-line prompt together instead of sending each line."""
    buf = f"se-{tid}-{os.getpid()}"
    tmux("load-buffer", "-b", buf, "-", stdin=text)
    tmux("paste-buffer", "-p", "-d", "-b", buf, "-t", session(tid))
    if enter:
        time.sleep(0.3)
        tmux("send-keys", "-t", session(tid), "Enter")


def write_tmux_conf():
    private_dir(STATE_DIR)
    conf = """# Written by speakeasy; regenerated on every new task.
set -g default-terminal "tmux-256color"
set -as terminal-features ",*:RGB,*:extkeys,*:hyperlinks"
set -g extended-keys on
set -g allow-passthrough on
set -g escape-time 10
set -g history-limit 50000
set -g mouse on
set -g remain-on-exit on
set -g destroy-unattached off
set -g detach-on-destroy on
set -g set-titles on
set -g set-titles-string "#{@se_title} · speakeasy #{session_name}"
set -g status-position bottom
set -g status-style "fg=default,bg=default"
set -g status-left " #[bold]#{@se_title}#[nobold]  #[dim]#{@se_agent}"
set -g status-left-length 120
set -g status-right "#[dim]close the window to hide it · the task keeps running "
set -g status-right-length 80
set -g window-status-format ""
set -g window-status-current-format ""
"""
    with private_open(TMUX_CONF) as f:
        f.write(conf)


def live_sessions():
    r = tmux("list-sessions", "-F", "#{session_name} #{session_attached}")
    if r.returncode != 0:
        return {}
    out = {}
    for line in r.stdout.splitlines():
        name, _, attached = line.partition(" ")
        out[name] = attached not in ("", "0")
    return out


def reconcile(tasks):
    """Mark tasks whose tmux session vanished (reboot, tmux killed) as exited."""
    sessions = live_sessions()
    for t in tasks:
        t["alive"] = session(t["id"]) in sessions
        t["attached"] = sessions.get(session(t["id"]), False)
        if t.get("status") in LIVE and session(t["id"]) not in sessions:
            # Nobody saw how it ended, so it stays unchecked (and is kept by `clear`).
            nt = update_task(t["id"], status="exited", detail="The terminal session is gone.", unseen=True)
            if nt:
                t.update(nt)
                t["alive"] = t["attached"] = False
    return tasks


# ---------------------------------------------------------- notifications --

def notify(task, title, body, urgency="normal"):
    """Show a notification whose click opens the task, without blocking.

    The text goes to the worker on stdin: the worker lives until the
    notification is clicked or closed, and its arguments are world-readable."""
    if not config().get("notify", True) or not (shutil.which("gdbus") or shutil.which("notify-send")):
        return
    proc = subprocess.Popen([sys.executable, SELF, "_notify", task["id"]],
                            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            start_new_session=True, text=True)
    try:
        proc.stdin.write(json.dumps({"title": title, "body": body, "urgency": urgency}))
        proc.stdin.close()
    except OSError:
        pass


def gvariant_str(text):
    """A GVariant string literal for gdbus (JSON escapes are valid GVariant)."""
    return json.dumps(text, ensure_ascii=False)


def notify_dbus(title, body, urgency):
    """Send through D-Bus with a short-lived gdbus call; return the action
    clicked, or "" when the notification closes. None if gdbus failed."""
    level = {"low": 0, "normal": 1, "critical": 2}.get(urgency, 1)
    monitor = subprocess.Popen(["gdbus", "monitor", "--session", "--dest", "org.freedesktop.Notifications",
                                "--object-path", "/org/freedesktop/Notifications"],
                               stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    try:
        time.sleep(0.2)  # let the monitor subscribe before the notification exists
        r = subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                            "--object-path", "/org/freedesktop/Notifications",
                            "--method", "org.freedesktop.Notifications.Notify",
                            '"Speakeasy"', "uint32 0", '"utilities-terminal"',
                            gvariant_str(title), gvariant_str(body),
                            '["default", "Open", "open", "Open terminal"]',
                            "{'urgency': <byte %d>}" % level, "int32 -1"],
                           text=True, capture_output=True, timeout=10)
        m = re.search(r"uint32 (\d+)", r.stdout)
        if r.returncode != 0 or not m:
            return None
        nid = m.group(1)
        deadline = time.time() + 6 * 3600
        for line in monitor.stdout:
            if f"ActionInvoked (uint32 {nid}," in line:
                a = re.search(r"'([^']*)'\)", line)
                return a.group(1) if a else ""
            if f"NotificationClosed (uint32 {nid}," in line or time.time() > deadline:
                return ""
        return ""
    except (OSError, subprocess.TimeoutExpired):
        return None
    finally:
        monitor.kill()


def cmd_notify_worker(a):
    try:
        msg = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        return
    title, body, urgency = str(msg.get("title", "")), str(msg.get("body", "")), str(msg.get("urgency", "normal"))
    action = notify_dbus(title, body, urgency) if shutil.which("gdbus") else None
    if action is None and shutil.which("notify-send"):
        # Fallback without gdbus: notify-send keeps the text in its arguments
        # while it waits, so it is sent without the body.
        r = subprocess.run(["notify-send", "--app-name=Speakeasy", f"--urgency={urgency}",
                            "--icon=utilities-terminal", "--action=default=Open", "--", title],
                           text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        action = r.stdout.strip()
    if os.environ.get("SPEAKEASY_DEBUG"):
        with private_open(os.path.join(STATE_DIR, "hooks.log"), "a") as f:
            f.write(json.dumps({"id": a.id, "event": "notify-action", "action": action}) + "\n")
    if action in ("default", "open"):
        task = load_task(a.id)
        if task:
            open_task(task)


# ------------------------------------------------------------ launching --

def build_command(task, agent):
    """argv for the agent itself, and the prompt to type if it takes keys."""
    argv = [agent["path"] or agent["bin"]] + list(agent.get("baseArgs") or [])
    extra = task.get("args") or []
    # Values ride on their flag ("--model=x") and the prompt comes after
    # "--", so a title, prompt or model that starts with "-" stays text.
    if task.get("model") and agent.get("modelFlag"):
        argv.append(f"{agent['modelFlag']}={task['model']}")
    if task.get("effort") and agent.get("effortArgs"):
        argv += [x.replace("{}", task["effort"]) for x in agent["effortArgs"]]
    if agent["report"] == "claude":
        argv += ["--settings", json.dumps(claude_hooks(task["id"]))]
    elif agent["report"] == "codex":
        argv += ["-c", "notify=" + json.dumps([sys.executable, SELF, "hook", task["id"], "codex"])]
    argv += extra
    prompt = task.get("prompt") or ""
    typed = ""
    if prompt:
        # Built-in agents all get the prompt typed in ("keys"): arguments of
        # a long-running process are readable by every user on the machine.
        mode = agent.get("prompt", "keys")
        if mode == "arg":
            argv += ["--", prompt]
        elif mode.startswith("flag:"):
            argv.append(f"{mode[5:]}={prompt}")
        else:
            typed = prompt
    return argv, typed


def claude_hooks(tid):
    def hook(event):
        return [{"hooks": [{"type": "command",
                            "command": " ".join(shlex.quote(x) for x in [sys.executable, SELF, "hook", tid, event])}]}]
    return {"hooks": {name: hook(name) for name in
                      ("SessionStart", "UserPromptSubmit", "PostToolUse", "PermissionRequest", "Notification", "Stop")}}


def cmd_new(a):
    cfg = config()
    if a.interactive:
        interactive_new(a, cfg)
    if not a.title and not a.prompt:
        die("give the task a --title or a --prompt (or use -i)")
    agent = agent_by_id(a.agent or "")
    if agent is None:
        die(f"unknown agent {a.agent!r}; see `speakeasy agents`")
    if not agent["installed"]:
        die(f"{agent['name']} ({agent['bin']}) is not installed")
    if not shutil.which("tmux"):
        die("tmux is required")
    cwd = os.path.abspath(os.path.expanduser(a.cwd or cfg.get("defaultCwd") or "~"))
    if not os.path.isdir(cwd):
        die(f"folder does not exist: {cwd}")
    effort = a.effort or ""
    if effort and effort not in efforts_for(agent, a.model or ""):
        allowed = ", ".join(efforts_for(agent, a.model or "")) or "none"
        die(f"{agent['name']} {a.model or 'default'} does not take effort {effort!r} (allowed: {allowed})")
    prompt = a.prompt
    if prompt == "-":
        prompt = sys.stdin.read()
    prompt = (prompt or "").strip()
    title = (a.title or prompt.splitlines()[0][:60]).strip()

    tid = secrets.token_hex(3)
    while os.path.exists(task_path(tid)):
        tid = secrets.token_hex(3)
    task = {
        "id": tid, "title": title, "prompt": prompt, "agent": agent["id"], "agentName": agent["name"],
        "model": a.model or "", "effort": effort, "cwd": cwd, "args": a.extra or [], "status": "starting",
        "detail": "", "unseen": False, "createdAt": now(), "updatedAt": now(),
        "exitCode": None, "sessionId": "",
    }
    private_dir(TASKS_DIR)
    write_json(task_path(tid), task)
    old = load_json(PREFS_PATH, {})
    recent = [cwd] + [d for d in old.get("recentCwds") or [] if d != cwd]
    write_json(PREFS_PATH, {"agent": agent["id"], "model": task["model"], "effort": effort, "cwd": cwd,
                            "recentCwds": recent[:10]})

    write_tmux_conf()
    label = " · ".join(x for x in (agent["name"], agent["modelLabels"].get(task["model"], task["model"]),
                                    effort) if x)
    r = tmux("new-session", "-d", "-s", session(tid), "-c", cwd, "-x", "200", "-y", "50",
             "-e", f"SPEAKEASY_TASK={tid}",
             shlex.join([sys.executable, SELF, "_run", tid]))
    if r.returncode != 0:
        update_task(tid, status="exited", detail="tmux failed: " + r.stderr.strip())
        die("tmux failed to start the task: " + r.stderr.strip())
    tmux("set-option", "-t", session(tid), "@se_title", title.replace("#", "##"))
    tmux("set-option", "-t", session(tid), "@se_agent", label.replace("#", "##"))
    bump_rev()
    if a.json:
        print(json.dumps(load_task(tid)))
    else:
        print(f"{tid}  {title}  ({label}, {cwd})")
    if a.open:
        open_task(load_task(tid))


def interactive_new(a, cfg):
    """Plain prompts for desktops without the Omarchy panel."""
    installed = [x for x in agents(cfg) if x["installed"]]
    if not installed:
        die("no supported agent is installed")
    prefs = load_json(PREFS_PATH, {})
    for i, x in enumerate(installed, 1):
        print(f"  {i}. {x['name']}")
    default = next((i for i, x in enumerate(installed, 1) if x["id"] == prefs.get("agent")), 1)
    pick = input(f"Agent [{default}]: ").strip() or str(default)
    agent = installed[int(pick) - 1]
    models = agent["models"]
    if len(models) > 1:
        for i, m in enumerate(models, 1):
            print(f"  {i}. {agent['modelLabels'].get(m) or m or 'default'}")
        pick = input("Model [1]: ").strip() or "1"
        a.model = models[int(pick) - 1]
    efforts = efforts_for(agent, a.model or "")
    if efforts:
        pick = input(f"Effort ({', '.join(efforts)}) [default]: ").strip()
        a.effort = pick if pick in efforts else ""
    a.agent = agent["id"]
    a.title = input("Title: ").strip()
    print("Describe the task (finish with an empty line):")
    lines = []
    while True:
        line = input()
        if line == "":
            break
        lines.append(line)
    a.prompt = "\n".join(lines)
    a.cwd = input(f"Folder [{prefs.get('cwd') or cfg.get('defaultCwd')}]: ").strip() or prefs.get("cwd") or a.cwd


def cmd_run(a):
    """Runs inside the tmux pane: start the agent, watch it, record its exit."""
    task = load_task(a.id)
    if task is None:
        die("task vanished")
    agent = agent_by_id(task["agent"])
    argv, typed = build_command(task, agent)
    update_task(a.id, status="running" if agent["report"] != "claude" else "starting")
    try:
        proc = subprocess.Popen(argv, cwd=task["cwd"])
    except OSError as e:
        update_task(a.id, status="exited", detail=str(e), exitCode=127)
        print(f"speakeasy: could not start {argv[0]}: {e}")
        return
    stop = threading.Event()
    if typed:
        threading.Thread(target=type_prompt, args=(a.id, typed, agent, stop), daemon=True).start()
    threading.Thread(target=watch_quiet, args=(a.id, agent, stop), daemon=True).start()
    # Let Ctrl+C reach the agent, not this wrapper.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    code = proc.wait()
    stop.set()
    task = load_task(a.id) or task
    if task.get("status") != "stopped":
        task = update_task(a.id, status="exited", exitCode=code, unseen=True,
                           detail="Finished." if code == 0 else f"Exited with status {code}.")
        notify(task, f"{task['title']} ended", task["detail"] + " Click to see the output.")
    print(f"\n[speakeasy] {agent['name']} exited with status {code}. "
          f"Close this window, or remove the task with `speakeasy rm {a.id}`.")


def type_prompt(tid, text, agent, stop):
    """Type the first prompt once the agent is ready for it.

    Ready means: the screen has settled, no question or menu is showing (a
    trust dialog, a sign-in, a model picker: typing into one could pick an
    answer), and for Claude Code its SessionStart hook has fired. It waits
    as long as the agent is alive, so a trust question can take its time."""
    started = time.time()
    last, stable = None, 0
    while not stop.wait(0.5):
        cur = capture(tid, 80)
        stable = stable + 1 if cur == last and cur.strip() else 0
        last = cur
        if blocking_question(cur):
            stable = 0
            continue
        if agent["report"] == "claude":
            task = load_task(tid) or {}
            if task.get("status") == "starting":
                continue
        if stable >= 3 and time.time() - started >= 2:
            paste(tid, text)
            update_task(tid, promptSent=True)
            return


def capture(tid, lines=40):
    r = tmux("capture-pane", "-p", "-J", "-t", session(tid), "-S", f"-{lines}")
    return r.stdout if r.returncode == 0 else ""


# Start-up screens that stop an agent before it does anything, spotted on its
# screen: (all these words appear, what to tell the user).
BLOCKING = [
    (("hooks need review",), "Codex wants you to review the hooks in ~/.codex/hooks.json (trust them once in Codex to stop this)."),
    (("oauth/device",), "Asks you to sign in to the agent (a browser sign-in code is on its screen)."),
    (("trust", "folder"), "Asks whether to trust this folder."),
    (("trust", "project"), "Asks whether to trust this folder."),
    (("trust", "workspace"), "Asks whether to trust this folder."),
    (("do you want to proceed",), "Waiting on a question."),
    (("enter to confirm",), "Waiting on a question."),
    (("enter confirm",), "Waiting on a question."),
    (("enter continue",), "Waiting on a question."),
    (("enter to select",), "Waiting on a question."),
    (("to navigate",), "Waiting on a question."),
    (("then enter",), "Waiting on a question."),
]
BLOCKING_MESSAGES = {msg for _, msg in BLOCKING}


def blocking_question(screen):
    low = screen.lower()
    for words, msg in BLOCKING:
        if all(w in low for w in words):
            return msg
    return ""


def watch_quiet(tid, agent, stop):
    """Call the agent 'ready' once its screen stops changing.

    Agents that report through hooks (Claude) are only watched while still
    'starting': a first-run question such as Claude's folder-trust dialog
    comes before any hook fires, and would otherwise sit unnoticed.
    """
    hooked = agent["report"] == "claude"
    quiet = float(config().get("quietSeconds") or 20)
    last, changed_at, announced = None, time.time(), False
    while not stop.wait(2.0):
        cur = capture(tid, 80)
        t = time.time()
        if cur != last:
            last, changed_at = cur, t
            task = load_task(tid)
            if task and announced and (task.get("status") == "ready" and not hooked
                                       or task.get("status") == "needs-you" and task.get("detail", "") in BLOCKING_MESSAGES):
                update_task(tid, status="running", detail="")
            announced = False
            continue
        if announced or t - changed_at < min(quiet, 8 if hooked else quiet):
            continue
        announced = True
        task = load_task(tid)
        if not task:
            continue
        ask = blocking_question(cur) if task.get("status") in ("starting", "running") else ""
        if ask or (hooked and task.get("status") == "starting"):
            msg = ask or "Waiting on a question before it starts."
            task = update_task(tid, status="needs-you", unseen=True, detail=msg)
            notify(task, f"{task['title']} needs you", msg, urgency="critical")
        elif hooked:
            continue
        elif task.get("status") in ("running", "starting"):
            task = update_task(tid, status="ready", unseen=True,
                               detail="Quiet for a while: probably finished or waiting for you.")
            notify(task, f"{task['title']} is waiting", "The output stopped changing. Click to look.")


# ------------------------------------------------------------------ hooks --

def cmd_hook(a):
    """Called by the agent (Claude hooks, Codex notify) to report its state."""
    payload = {}
    if a.event == "codex":
        try:
            payload = json.loads(a.payload[-1]) if a.payload else {}
        except ValueError:
            payload = {}
    else:
        try:
            raw = sys.stdin.read()
            payload = json.loads(raw) if raw.strip() else {}
        except (ValueError, OSError):
            payload = {}
    if os.environ.get("SPEAKEASY_DEBUG"):
        with private_open(os.path.join(STATE_DIR, "hooks.log"), "a") as f:
            f.write(json.dumps({"id": a.id, "event": a.event, "payload": payload}) + "\n")
    task = load_task(a.id)
    if task is None or task.get("status") in FINISHED:
        return
    ev = a.event
    if ev == "SessionStart":
        update_task(a.id, status="running", sessionId=payload.get("session_id", task.get("sessionId", "")))
    elif ev in ("UserPromptSubmit", "PostToolUse"):
        if task.get("status") != "running":
            update_task(a.id, status="running", detail="", unseen=False, pendingAsk="")
    elif ev == "PermissionRequest":
        # Arrives just before the permission Notification; remember what is
        # being asked so the alert can say it.
        update_task(a.id, pendingAsk=describe_tool(payload.get("tool_name", ""), payload.get("tool_input") or {}))
    elif ev == "Notification":
        kind = payload.get("notification_type", "")
        msg = payload.get("message") or "Claude needs your attention."
        if kind == "permission_prompt" and task.get("pendingAsk"):
            msg = "Wants to " + task["pendingAsk"]
        if kind == "idle_prompt" and task.get("status") == "ready":
            return  # already announced by Stop
        if kind in ("auth_success",):
            return
        task = update_task(a.id, status="needs-you", detail=msg, unseen=True)
        notify(task, f"{task['title']} needs you", msg, urgency="critical")
    elif ev == "Stop":
        summary = first_line(payload.get("last_assistant_message") or "") or \
            last_assistant_line(payload.get("transcript_path"))
        task = update_task(a.id, status="ready", detail=summary or "Finished its turn.", unseen=True)
        notify(task, f"{task['title']} is done", summary or "Results are ready. Click to open.")
    elif ev == "codex":
        if payload.get("type") == "agent-turn-complete":
            msg = (payload.get("last-assistant-message") or "").strip()
            if is_codex_title_turn(msg):
                return
            task = update_task(a.id, status="ready", detail=first_line(msg) or "Finished its turn.", unseen=True)
            notify(task, f"{task['title']} is done", first_line(msg, 200) or "Results are ready. Click to open.")


def is_codex_title_turn(msg):
    """Codex runs a side turn to name the thread; its reply is {"title": ...}."""
    try:
        data = json.loads(msg)
    except ValueError:
        return False
    return isinstance(data, dict) and set(data) == {"title"}


def describe_tool(name, inp):
    """'run: npm test' / 'edit src/app.py' — what a permission prompt is about."""
    if name == "Bash":
        return "run: " + first_line(inp.get("command", ""), 100)
    if name in ("Write", "Edit", "MultiEdit", "NotebookEdit"):
        path = inp.get("file_path") or inp.get("notebook_path") or ""
        return ("write " if name == "Write" else "edit ") + os.path.basename(path)
    if name == "WebFetch":
        return "fetch " + inp.get("url", "")
    if name == "WebSearch":
        return "search the web: " + inp.get("query", "")
    return f"use {name}" if name else "do something"


def first_line(text, limit=140):
    for line in (text or "").splitlines():
        line = line.strip().lstrip("#*- ").strip()
        if line:
            return line if len(line) <= limit else line[: limit - 1] + "…"
    return ""


def last_assistant_line(path):
    """First line of Claude's last text reply, read from the session transcript."""
    if not path or not os.path.exists(path):
        return ""
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 400_000))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    for raw in reversed(lines):
        try:
            entry = json.loads(raw)
        except ValueError:
            continue
        msg = entry.get("message") or {}
        if entry.get("type") != "assistant" or msg.get("role") != "assistant":
            continue
        for block in msg.get("content") or []:
            if isinstance(block, dict) and block.get("type") == "text" and block.get("text", "").strip():
                return first_line(block["text"])
    return ""


# ------------------------------------------------------------------- open --

def terminal_prefix(cfg):
    custom = (cfg.get("terminal") or os.environ.get("SPEAKEASY_TERMINAL") or "").strip()
    if custom:
        return shlex.split(custom)
    for name, prefix in (("xdg-terminal-exec", ["xdg-terminal-exec"]),
                         ("ghostty", ["ghostty", "-e"]), ("foot", ["foot"]), ("kitty", ["kitty"]),
                         ("alacritty", ["alacritty", "-e"]), ("wezterm", ["wezterm", "start", "--"]),
                         ("konsole", ["konsole", "-e"]), ("gnome-terminal", ["gnome-terminal", "--"]),
                         ("xterm", ["xterm", "-e"])):
        if shutil.which(name):
            return prefix
    return []


def focus_existing(tid):
    """On Hyprland, focus a window already attached to this task."""
    if not shutil.which("hyprctl"):
        return False
    r = subprocess.run(["hyprctl", "-j", "clients"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        clients = json.loads(r.stdout or "[]")
    except ValueError:
        return False
    marker = f"speakeasy {session(tid)}"
    for c in clients:
        if marker in (c.get("title") or ""):
            addr = c["address"]
            # Hyprland 0.55+ with a Lua config takes Lua dispatchers; older
            # (hyprlang) configs take the classic `focuswindow` form.
            r = subprocess.run(["hyprctl", "dispatch", f'hl.dsp.focus({{ window = "address:{addr}" }})'],
                               text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            if r.returncode != 0 or "error" in r.stdout.lower():
                subprocess.run(["hyprctl", "dispatch", "focuswindow", f"address:{addr}"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
    return False


def open_task(task):
    tid = task["id"]
    if task.get("unseen"):
        task = update_task(tid, unseen=False) or task
    if session(tid) not in live_sessions():
        die(f"task {tid} has no terminal any more")
    if focus_existing(tid):
        return
    prefix = terminal_prefix(config())
    if not prefix:
        die("no terminal emulator found; set \"terminal\" in " + CONFIG_PATH)
    attach = ["tmux", "-L", SOCKET, "-f", TMUX_CONF, "attach-session", "-t", session(tid)]
    subprocess.Popen(prefix + attach, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, cwd=task.get("cwd") or HOME)


def cmd_open(a):
    if a.ref == "next":
        tasks = sorted(reconcile(all_tasks()), key=sort_key)
        pick = next((t for t in tasks if t["status"] == "needs-you" or t.get("unseen")), None)
        if pick is None:
            die("nothing is waiting for you")
        open_task(pick)
        return
    open_task(resolve(a.ref))


# ------------------------------------------------------------ list & co. --

ORDER = {"needs-you": 0, "ready": 1, "running": 2, "starting": 3, "exited": 4, "stopped": 5}


def sort_key(t):
    # Attention first; inside a group, newest activity first.
    return (ORDER.get(t.get("status"), 9), -(dt.datetime.fromisoformat(t["updatedAt"]).timestamp()))


def cmd_list(a):
    tasks = sorted(reconcile(all_tasks()), key=sort_key)
    if a.json:
        print(json.dumps(tasks))
        return
    if not tasks:
        print("No tasks. Start one with `speakeasy new`.")
        return
    for t in tasks:
        model = f"·{t['model']}" if t.get("model") else ""
        flag = "*" if t.get("unseen") else " "
        print(f"{t['id']} {flag}{t['status']:<9} {t['title'][:48]:<48} {t['agent']}{model}")


def cmd_state(a):
    """Everything the panel needs in one call."""
    if not os.path.exists(REV_PATH):
        bump_rev()
    cfg = config()
    tasks = sorted(reconcile(all_tasks()), key=sort_key)
    items = agents(cfg)
    refresh_stale_models(items)
    prefs = load_json(PREFS_PATH, {})
    # The remembered folder may have been deleted since; fall back rather
    # than pre-fill a path that `new` would refuse.
    if prefs.get("cwd") and not os.path.isdir(prefs["cwd"]):
        prefs["cwd"] = ""
    out = {
        "version": VERSION,
        "tmux": shutil.which("tmux") is not None,
        "settings": {"notify": cfg.get("notify", True) is not False,
                     "defaultCwd": cfg.get("defaultCwd") or "~",
                     "quietSeconds": cfg.get("quietSeconds") or 20},
        "agents": [dict({k: x[k] for k in ("id", "name", "bin", "models", "modelLabels", "installed", "hidden", "report", "modelEfforts")},
                        efforts=x["efforts"] if x.get("effortArgs") else []) for x in items],
        "tasks": tasks,
        "prefs": {"agent": prefs.get("agent", ""), "model": prefs.get("model", ""), "effort": prefs.get("effort", ""),
                  "cwd": prefs.get("cwd") or os.path.expanduser(cfg.get("defaultCwd") or "~")},
        "defaultCwd": default_cwd(cfg),
    }
    print(json.dumps(out))


def update_config(**changes):
    """Change keys in the user's config file, keeping everything else in it."""
    user = load_json(CONFIG_PATH, {})
    if not isinstance(user, dict):
        die(f"{CONFIG_PATH} is not a JSON object; fix or remove it first")
    user.update(changes)
    write_json(CONFIG_PATH, user)
    bump_rev()


def cmd_agents(a):
    if a.hide or a.show:
        known = {x["id"] for x in agents()}
        for aid in a.hide + a.show:
            if aid not in known:
                die(f"unknown agent {aid!r}; see `speakeasy agents`")
        hidden = [x for x in config().get("hiddenAgents") or [] if x not in a.show]
        hidden += [x for x in a.hide if x not in hidden]
        update_config(hiddenAgents=hidden)
    items = agents()
    if a.json:
        print(json.dumps(items))
        return
    for x in items:
        models = ", ".join(m or "default" for m in x["models"])
        flag = "hidden" if x["hidden"] else ("✓" if x["installed"] else "")
        print(f"{flag:<6} {x['id']:<13} {x['name']:<15} {models}")


SETTINGS = {
    # name on the command line: (config key, parser)
    "notify": ("notify", lambda v: {"on": True, "off": False, "true": True, "false": False}[v.lower()]),
    "default-cwd": ("defaultCwd", lambda v: v),
    "quiet-seconds": ("quietSeconds", lambda v: max(5, min(600, int(v)))),
    "terminal": ("terminal", lambda v: v),
}


def cmd_set(a):
    key, parse = SETTINGS[a.key]
    try:
        value = parse(a.value)
    except (KeyError, ValueError):
        die(f"bad value for {a.key}: {a.value!r}")
    if a.key == "default-cwd" and not os.path.isdir(os.path.expanduser(value)):
        die(f"folder does not exist: {value}")
    update_config(**{key: value})
    print(f"{a.key} = {value}")


def default_cwd(cfg):
    d = os.path.expanduser(cfg.get("defaultCwd") or "~")
    return d if os.path.isdir(d) else HOME


def tilde(path):
    return "~" + path[len(HOME):] if path == HOME or path.startswith(HOME + "/") else path


def cmd_dirs(a):
    """Folder completion for the new-task form: the subfolders matching what
    has been typed so far, plus recent task folders."""
    text = a.path
    full = os.path.expanduser(text) if text else ""
    if not text:
        base, prefix = HOME, ""
    elif text.endswith("/"):
        base, prefix = full, ""
    else:
        base, prefix = os.path.dirname(full) or "/", os.path.basename(full)
    entries = []
    try:
        with os.scandir(base) as it:
            for e in it:
                if e.name.startswith(".") and not prefix.startswith("."):
                    continue
                try:
                    if not e.is_dir():
                        continue
                except OSError:
                    continue
                entries.append(e)
    except OSError:
        pass
    low = prefix.lower()
    starts = sorted((e for e in entries if e.name.lower().startswith(low)), key=lambda e: e.name.lower())
    inside = sorted((e for e in entries if low and low in e.name.lower() and not e.name.lower().startswith(low)),
                    key=lambda e: e.name.lower())
    out = [{"name": e.name, "path": tilde(e.path), "git": os.path.exists(os.path.join(e.path, ".git"))}
           for e in (starts + inside)[:a.limit]]
    recent = []
    if not prefix or not text:
        seen = load_json(PREFS_PATH, {}).get("recentCwds") or []
        for t in sorted(all_tasks(), key=lambda t: t.get("createdAt", ""), reverse=True):
            if t.get("cwd") and t["cwd"] not in seen:
                seen.append(t["cwd"])
        for d in seen:
            if os.path.isdir(d) and (not text or tilde(d).startswith(text) or d.startswith(full)):
                recent.append({"name": os.path.basename(d) or d, "path": tilde(d),
                               "git": os.path.exists(os.path.join(d, ".git"))})
    print(json.dumps({"base": tilde(base), "exists": os.path.isdir(base), "entries": out, "recent": recent[:6]}))


def cmd_peek(a):
    t = resolve(a.ref)
    # Agent TUIs pad the screen with blank rows; show the last lines with ink.
    lines = [ln.rstrip() for ln in capture(t["id"], max(200, a.lines * 4)).splitlines()]
    print("\n".join([ln for ln in lines if ln.strip()][-a.lines:]))


def cmd_send(a):
    t = resolve(a.ref)
    if session(t["id"]) not in live_sessions():
        die("that task has no terminal any more")
    text = " ".join(a.text)
    if text == "-":
        text = sys.stdin.read().rstrip("\n")
    paste(t["id"], text)


def cmd_seen(a):
    t = resolve(a.ref)
    update_task(t["id"], unseen=False)


def cmd_rename(a):
    t = resolve(a.ref)
    title = " ".join(a.title).strip()
    if not title:
        die("empty title")
    update_task(t["id"], title=title)
    tmux("set-option", "-t", session(t["id"]), "@se_title", title.replace("#", "##"))


def stop_task(t):
    if t.get("status") in LIVE:
        update_task(t["id"], status="stopped", detail="Stopped.", unseen=False)
    tmux("kill-session", "-t", session(t["id"]))


def cmd_stop(a):
    stop_task(resolve(a.ref))


def cmd_rm(a):
    t = resolve(a.ref)
    stop_task(t)
    for p in (task_path(t["id"]), task_path(t["id"]) + ".lock"):
        try:
            os.remove(p)
        except OSError:
            pass
    bump_rev()


# Completed: the agent finished its turn (ready), ended, or was stopped.
COMPLETED = ("ready",) + FINISHED


def cmd_clear(a):
    """Remove completed tasks. Ones whose results you have not looked at yet
    (never opened or peeked, still marked unseen) are kept unless asked."""
    removed, kept = 0, 0
    for t in reconcile(all_tasks()):
        if t.get("status") not in COMPLETED:
            continue
        if t.get("unseen") and not a.include_unchecked:
            kept += 1
            continue
        tmux("kill-session", "-t", session(t["id"]))
        for p in (task_path(t["id"]), task_path(t["id"]) + ".lock"):
            try:
                os.remove(p)
            except OSError:
                pass
        removed += 1
    bump_rev()
    if a.json:
        print(json.dumps({"removed": removed, "kept": kept}))
        return
    msg = f"Removed {removed} completed task{'s' if removed != 1 else ''}."
    if kept:
        msg += f" Kept {kept} you haven't checked yet (open or peek them first, or use --include-unchecked)."
    print(msg)


PLUGIN_ID = "ninepointlabs.speakeasy"


def cmd_ui(a):
    """Keybinding entry point: the centered Omarchy window if it is there, else a terminal."""
    shell = shutil.which("omarchy-shell")
    if shell:
        # `list` toggles the window; `new` opens it on the form.
        r = subprocess.run([shell, PLUGIN_ID, "present", a.view], text=True,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if r.stdout.strip() in ("ok", "hidden"):
            return
    prefix = terminal_prefix(config())
    if not prefix:
        die("no terminal emulator found")
    inner = [sys.executable, SELF, "new", "-i", "-o"] if a.view == "new" else \
        ["sh", "-c", f"{shlex.quote(sys.executable)} {shlex.quote(SELF)} list; echo; read -r -p 'Press Enter to close' _"]
    subprocess.Popen(prefix + inner, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ------------------------------------------------------------------- main --

def main(argv=None):
    p = argparse.ArgumentParser(prog="speakeasy", description="AI agents in hidden terminals, one named tab per task.")
    p.add_argument("--version", action="version", version=f"speakeasy {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("new", help="start a task in a hidden terminal")
    s.add_argument("-a", "--agent", default="claude")
    s.add_argument("-m", "--model", default="")
    s.add_argument("-e", "--effort", default="", help="reasoning effort, where the agent has one")
    s.add_argument("-t", "--title", default="")
    s.add_argument("-p", "--prompt", default="", help="the task description; '-' reads stdin")
    s.add_argument("-C", "--cwd", default="")
    s.add_argument("-i", "--interactive", action="store_true", help="ask for everything")
    s.add_argument("-o", "--open", action="store_true", help="also open its terminal now")
    s.add_argument("--json", action="store_true")
    s.add_argument("extra", nargs="*", help="extra agent arguments, after --")
    s.set_defaults(fn=cmd_new)

    s = sub.add_parser("list", aliases=["ls"], help="list tasks, attention first")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("open", help="show a task's terminal (or `next` waiting task)")
    s.add_argument("ref")
    s.set_defaults(fn=cmd_open)

    s = sub.add_parser("dirs", help="folder completion for the new-task form (JSON)")
    s.add_argument("path", nargs="?", default="")
    s.add_argument("--limit", type=int, default=200)
    s.set_defaults(fn=cmd_dirs)

    s = sub.add_parser("peek", help="print the last lines of a task's screen")
    s.add_argument("ref")
    s.add_argument("-n", "--lines", type=int, default=30)
    s.set_defaults(fn=cmd_peek)

    s = sub.add_parser("send", help="type a line into a task and press Enter")
    s.add_argument("ref")
    s.add_argument("text", nargs="+")
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("rename", help="rename a task")
    s.add_argument("ref")
    s.add_argument("title", nargs="+")
    s.set_defaults(fn=cmd_rename)

    s = sub.add_parser("seen", help="clear a task's unseen mark")
    s.add_argument("ref")
    s.set_defaults(fn=cmd_seen)

    s = sub.add_parser("stop", help="stop a task, keep it in the list")
    s.add_argument("ref")
    s.set_defaults(fn=cmd_stop)

    s = sub.add_parser("rm", help="stop a task and remove it")
    s.add_argument("ref")
    s.set_defaults(fn=cmd_rm)

    s = sub.add_parser("clear", help="remove completed tasks you have checked (opened or peeked)")
    s.add_argument("--include-unchecked", action="store_true", help="also remove completed tasks you have not looked at")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_clear)

    s = sub.add_parser("agents", help="show supported agents; --hide/--show one in the new-task picker")
    s.add_argument("--json", action="store_true")
    s.add_argument("--hide", action="append", default=[], metavar="AGENT")
    s.add_argument("--show", action="append", default=[], metavar="AGENT")
    s.set_defaults(fn=cmd_agents)

    s = sub.add_parser("set", help="change a setting: notify on|off, default-cwd PATH, quiet-seconds N, terminal CMD")
    s.add_argument("key", choices=sorted(SETTINGS))
    s.add_argument("value")
    s.set_defaults(fn=cmd_set)

    s = sub.add_parser("models", help="list models per agent; --refresh asks the agent again")
    s.add_argument("agent", nargs="?", default="")
    s.add_argument("--refresh", action="store_true")
    s.add_argument("--quiet", action="store_true", help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_models)

    s = sub.add_parser("state", help="tasks, agents and defaults as JSON (for the panel)")
    s.set_defaults(fn=cmd_state)

    s = sub.add_parser("ui", help="show the task list or the new-task form (for keybindings)")
    s.add_argument("view", nargs="?", default="list", choices=["list", "new"])
    s.set_defaults(fn=cmd_ui)

    s = sub.add_parser("hook", help=argparse.SUPPRESS)
    s.add_argument("id")
    s.add_argument("event")
    s.add_argument("payload", nargs="*")
    s.set_defaults(fn=cmd_hook)

    s = sub.add_parser("_run", help=argparse.SUPPRESS)
    s.add_argument("id")
    s.set_defaults(fn=cmd_run)

    s = sub.add_parser("_notify", help=argparse.SUPPRESS)
    s.add_argument("id")
    s.set_defaults(fn=cmd_notify_worker)

    a = p.parse_args(argv)
    secure_existing_state()
    a.fn(a)


if __name__ == "__main__":
    main()
